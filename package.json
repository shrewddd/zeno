{
  "name": "zeno",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --parallel --workspaces dev",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "bun run --workspaces lint",
    "format": "bun run --workspaces format",
    "check": "bun run --workspaces check",
    "check:fix": "bun run --workspaces check:fix"
  }
}

